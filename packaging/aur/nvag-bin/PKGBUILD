# Maintainer: Shirak Semonian <semonian.it.solutions@gmail.com>

pkgname=nvag-bin
pkgver=1.0.4
pkgrel=1
pkgdesc="Database Management Studio voor meerdere databaseplatformen (SQL Server, PostgreSQL, MySQL, MariaDB, Db2, Oracle, Snowflake, Azure SQL/Synapse, Databricks, SQLite) — prebuilt AppImage van GitHub Releases"
arch=('x86_64')
url="https://github.com/Shirak-Semonian/nvag"
license=('MIT')
depends=('gtk3' 'libnotify' 'libsecret' 'libxss' 'nss')
optdepends=('fuse2: AppImage-runtime; zonder FUSE2 ook via --appimage-extract-and-run')
provides=('nvag')
conflicts=('nvag')

# AppImage is een zelf-uitpakkend ELF+squashfs: strippen/debug-splitsen
# beschadigt het artefact — byte-identiek installeren.
options=('!strip' '!debug')

_repo_owner='Shirak-Semonian'

source=("https://github.com/${_repo_owner}/Nvag/releases/download/v${pkgver}/Nvag-${pkgver}.AppImage"
        'nvag.desktop'
        'icon.png')

sha256sums=('64ce2e557cb93ef121e2c25c35a2be59ddb63b6468b276c550717294bb8a6a2a'
            'bb5c6cfab891b0b03161ef934858e22c126c0186dac0d4525c25c0cbbd38c8d6'
            '4363016ccf3541c84ae6a1eee83f507fb2b775aa89b9d6c8163875640267f9e9')

package() {
  # AppImage versieloos in /opt installeren (upgrade overschrijft, geen resten
  # van oude versies) + stabiele /usr/bin/nvag-symlink.
  install -Dm755 "${srcdir}/Nvag-${pkgver}.AppImage" "${pkgdir}/opt/nvag/nvag.AppImage"
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/nvag/nvag.AppImage "${pkgdir}/usr/bin/nvag"
  install -Dm644 "${srcdir}/nvag.desktop" "${pkgdir}/usr/share/applications/nvag.desktop"
  install -Dm644 "${srcdir}/icon.png" "${pkgdir}/usr/share/pixmaps/nvag.png"
}
